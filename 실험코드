import cv2
import numpy as np
import requests
import time


# =========================================================
# Pinky Pro 주소
# =========================================================
HOST = "http://192.168.4.1:8000"


# =========================================================
# 주행 설정
# =========================================================
BASE_SPEED = 25
KP = 0.12
MAX_SPEED = 40
SEARCH_SPEED = 18


# =========================================================
# 영상 처리 설정
# =========================================================
ROI_START_RATIO = 0.58

LOWER_WHITE = np.array([0, 0, 175])
UPPER_WHITE = np.array([180, 75, 255])

MIN_AREA = 500

STEP = 15
MIN_WIDTH = 25
MAX_JUMP = 60
MAX_POINTS = 8


# =========================================================
# 교차로 설정
#
# 첫 번째 교차로:
#   카메라 인식 X
#   AUTO 시작 후 18.8초가 되면 강제로 1번 교차로로 처리
#
# 첫 우회전 완료 후:
#   기존 1차 코드처럼 white_ratio로 교차로 인식
# =========================================================
INTERSECTION_ENTER = 0.93
INTERSECTION_EXIT = 0.90

intersection_count = 0
intersection_locked = False

clear_counter = 0
CLEAR_FRAMES = 10


# =========================================================
# 첫 번째 우회전 타이머
# =========================================================
FIRST_TURN_TIME = 18.8

auto_start_time = None
first_timer_turn_started = False
first_turn_done = False


# =========================================================
# 자동주행 상태
# =========================================================
auto_mode = False
last_error = 0


# =========================================================
# 우회전 상태
#
# 1번: 18.8초 타이머로 시작
# 2, 3번: 기존 white_ratio 교차로 검출로 시작
# =========================================================
turning = False
turn_target = None
turn_frames = 0

TURN_SPEED = 22
TURN_MIN_FRAMES = 8
TURN_MAX_FRAMES = 100

completed_turns = set()

# 첫 타이머 우회전에서는
# "기존 직진 도로가 화면 중앙에서 벗어났다"는 것을 한번 확인한 뒤
# 새 도로가 다시 중앙으로 들어왔을 때 회전을 끝낸다.
turn_departed_old_lane = False

# 화면 폭에 대한 비율
TURN_DEPART_ERROR_RATIO = 0.22
TURN_REACQUIRE_ERROR_RATIO = 0.18


# =========================================================
# Pinky 모터 명령
# =========================================================
def drive(left, right):

    left = int(np.clip(left, -100, 100))
    right = int(np.clip(right, -100, 100))

    try:
        requests.post(
            HOST + "/drive",
            json={
                "l": left,
                "r": right
            },
            timeout=0.3
        )

    except requests.RequestException:
        pass


def stop():

    try:
        requests.post(
            HOST + "/stop",
            timeout=0.3
        )

    except requests.RequestException:
        pass


# =========================================================
# 카메라 연결
# =========================================================
cap = cv2.VideoCapture(
    HOST + "/video"
)

if not cap.isOpened():

    print("카메라 연결 실패")
    raise SystemExit


print("""
=========================================
Pinky Pro Centerline + Timed First Turn
=========================================

P       : AUTO ON / OFF
W       : 수동 전진
S       : 수동 후진
A       : 수동 좌회전
D       : 수동 우회전
SPACE   : 정지
R       : 전체 주행 상태 초기화
ESC     : 종료
""")


# =========================================================
# 메인 루프
# =========================================================
while True:

    ret, frame = cap.read()

    if not ret:
        print("영상 수신 실패")
        break


    h, w = frame.shape[:2]


    # =====================================================
    # 1. ROI
    # =====================================================
    roi_start = int(
        h * ROI_START_RATIO
    )

    roi = frame[
        roi_start:h,
        :
    ]


    # =====================================================
    # 2. 노이즈 완화
    # =====================================================
    roi_blur = cv2.GaussianBlur(
        roi,
        (5, 5),
        0
    )


    # =====================================================
    # 3. HSV 변환
    # =====================================================
    hsv = cv2.cvtColor(
        roi_blur,
        cv2.COLOR_BGR2HSV
    )


    # =====================================================
    # 4. 흰색 도로 이진화
    # =====================================================
    mask = cv2.inRange(
        hsv,
        LOWER_WHITE,
        UPPER_WHITE
    )


    # =====================================================
    # 5. 작은 노이즈 제거
    # =====================================================
    kernel_open = np.ones(
        (3, 3),
        np.uint8
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        kernel_open,
        iterations=1
    )


    # =====================================================
    # 6. 도로 내부 작은 글씨 / 틈 완화
    #
    # 1차 코드 그대로 유지
    # 황토색을 따로 도로로 인식하지 않음
    # =====================================================
    kernel_close = np.ones(
        (17, 17),
        np.uint8
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel_close,
        iterations=2
    )


    # =====================================================
    # 7. 작은 흰색 덩어리 제거
    # =====================================================
    num_labels, labels, stats, _ = (
        cv2.connectedComponentsWithStats(
            mask,
            connectivity=8
        )
    )

    cleaned_mask = np.zeros_like(mask)


    for i in range(
        1,
        num_labels
    ):

        area = stats[
            i,
            cv2.CC_STAT_AREA
        ]

        if area >= MIN_AREA:

            cleaned_mask[
                labels == i
            ] = 255


    mask = cleaned_mask


    # =====================================================
    # 8. 흰색 비율 계산
    #
    # 첫 우회전 전에는 이 값으로 교차로를 세지 않는다.
    # 첫 우회전이 끝난 뒤부터 기존 1차 코드처럼 사용한다.
    # =====================================================
    white_ratio = (
        cv2.countNonZero(mask)
        / mask.size
    )


    # =====================================================
    # AUTO 경과 시간
    # =====================================================
    if (
        auto_start_time is not None
        and not first_turn_done
    ):

        elapsed_time = (
            time.monotonic()
            - auto_start_time
        )

    elif first_turn_done:

        elapsed_time = FIRST_TURN_TIME

    else:

        elapsed_time = 0.0


    # =====================================================
    # 9. 교차로 감지
    #
    # 핵심 수정:
    # 첫 우회전이 끝나기 전에는 white_ratio 교차로 검출을 OFF.
    #
    # → 출발 중 카메라에 멀리 있는 0.96 교차로가 보여도
    #   잘못 교차로로 세지 않음.
    #
    # 첫 우회전 이후에는 기존 1차 코드 기준 그대로 사용.
    # =====================================================
    if not first_turn_done:

        is_intersection = False
        clear_counter = 0


    else:

        if intersection_locked:

            is_intersection = (
                white_ratio
                > INTERSECTION_EXIT
            )

        else:

            is_intersection = (
                white_ratio
                > INTERSECTION_ENTER
            )


        # -------------------------------------------------
        # 새 교차로 카운트
        # -------------------------------------------------
        if (
            is_intersection
            and not intersection_locked
        ):

            intersection_count += 1
            intersection_locked = True
            clear_counter = 0

            print(
                f"INTERSECTION {intersection_count}"
            )


        # -------------------------------------------------
        # 교차로 탈출 확인
        # -------------------------------------------------
        if not is_intersection:

            clear_counter += 1

            if (
                clear_counter
                >= CLEAR_FRAMES
            ):

                intersection_locked = False
                clear_counter = 0

        else:

            clear_counter = 0


    # =====================================================
    # 10. 중심선 계산용 mask
    #
    # 1차 코드 그대로.
    # 황토색을 흰색으로 바꾸는 추가 처리는 하지 않는다.
    # =====================================================
    tracking_mask = mask.copy()


    # =====================================================
    # 11. 중심점 계산
    #
    # 1차 코드의 흰색 도로 중심선 계산 방식 유지
    # =====================================================
    roi_h, roi_w = (
        tracking_mask.shape
    )

    center_points = []

    prev_center = None


    for y in range(
        roi_h - 1,
        0,
        -STEP
    ):

        xs = np.where(
            tracking_mask[y] == 255
        )[0]


        if len(xs) == 0:
            continue


        # -------------------------------------------------
        # 흰색 영역 분리
        # -------------------------------------------------
        groups = np.split(
            xs,
            np.where(
                np.diff(xs) > 1
            )[0] + 1
        )


        # -------------------------------------------------
        # 너무 작은 영역 제거
        # -------------------------------------------------
        groups = [
            g
            for g in groups
            if len(g) >= MIN_WIDTH
        ]


        if len(groups) == 0:
            continue


        # =================================================
        # 첫 중심점
        # =================================================
        if prev_center is None:

            chosen = min(
                groups,
                key=lambda g:
                abs(
                    (
                        (g[0] + g[-1])
                        // 2
                    )
                    - roi_w // 2
                )
            )


        # =================================================
        # 이후 중심점: 이전 진행 방향 예측
        # =================================================
        else:

            predicted_x = prev_center


            if len(center_points) >= 2:

                x1 = center_points[-2][0]
                x2 = center_points[-1][0]

                dx = x2 - x1

                dx = int(
                    np.clip(
                        dx,
                        -35,
                        35
                    )
                )

                predicted_x = (
                    x2 + dx
                )


            chosen = min(
                groups,
                key=lambda g:
                abs(
                    (
                        (g[0] + g[-1])
                        // 2
                    )
                    - predicted_x
                )
            )


        x_left = chosen[0]
        x_right = chosen[-1]

        x_center = (
            x_left + x_right
        ) // 2


        # -------------------------------------------------
        # 갑자기 다른 영역으로 튀는 것 방지
        # -------------------------------------------------
        if prev_center is not None:

            if abs(
                x_center
                - prev_center
            ) > MAX_JUMP:

                continue


        original_y = (
            y + roi_start
        )


        center_points.append(
            (
                int(x_center),
                int(original_y)
            )
        )


        prev_center = x_center


        if (
            len(center_points)
            >= MAX_POINTS
        ):

            break


    # =====================================================
    # 12. 곡선 도로 2차 fitting
    # =====================================================
    if len(center_points) >= 5:

        try:

            ys = np.array(
                [
                    p[1]
                    for p in center_points
                ],
                dtype=np.float32
            )

            xs_fit = np.array(
                [
                    p[0]
                    for p in center_points
                ],
                dtype=np.float32
            )


            coeff = np.polyfit(
                ys,
                xs_fit,
                2
            )


            smooth_points = []


            for y_value in ys:

                x_value = (
                    coeff[0]
                    * y_value
                    * y_value

                    + coeff[1]
                    * y_value

                    + coeff[2]
                )


                x_value = np.clip(
                    x_value,
                    0,
                    w - 1
                )


                smooth_points.append(
                    (
                        int(x_value),
                        int(y_value)
                    )
                )


            center_points = smooth_points


        except Exception:
            pass


    # =====================================================
    # 13. 결과 화면
    # =====================================================
    result = frame.copy()


    # ROI 시작선
    cv2.line(
        result,
        (0, roi_start),
        (w, roi_start),
        (0, 255, 255),
        2
    )


    # 카메라 중앙선
    cv2.line(
        result,
        (w // 2, roi_start),
        (w // 2, h),
        (0, 255, 0),
        2
    )


    # 중심점
    for x, y in center_points:

        cv2.circle(
            result,
            (x, y),
            4,
            (0, 0, 255),
            -1
        )


    # 중심선
    for i in range(
        len(center_points) - 1
    ):

        cv2.line(
            result,
            center_points[i],
            center_points[i + 1],
            (255, 0, 0),
            3
        )


    # =====================================================
    # 14. Center Error 계산
    # =====================================================
    error = None


    # 1차 코드처럼:
    # 일반도로에서는 추종
    # 2, 3번 white-ratio 교차로에서는 회전 state가 우선
    allow_tracking = (
        not is_intersection
        or intersection_count == 1
    )


    if (
        len(center_points) >= 3
        and allow_tracking
    ):

        target_index = min(
            2,
            len(center_points) - 1
        )

        target_x, target_y = (
            center_points[
                target_index
            ]
        )


        error = (
            target_x
            - w // 2
        )


        last_error = error


        # 목표점
        cv2.circle(
            result,
            (
                target_x,
                target_y
            ),
            9,
            (0, 255, 255),
            -1
        )


        cv2.putText(
            result,
            f"Center Error: {error}",
            (20, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 0, 255),
            2
        )


    # =====================================================
    # 15. 자동 중심선 추종
    # =====================================================
    if auto_mode:


        # =================================================
        # A. 현재 우회전 수행 중
        # =================================================
        if turning:

            drive(
                TURN_SPEED,
                -TURN_SPEED
            )

            turn_frames += 1


            # ------------------------------------------------
            # 첫 번째(18.8초) 우회전
            #
            # 첫 교차로는 황토색이라 is_intersection=False일 수 있으므로
            # 기존의 "교차로를 벗어났다" 조건만 사용하면
            # 너무 일찍 회전이 끝날 수 있다.
            #
            # 따라서:
            # 1) 기존 직진 중심선이 한번 크게 옆으로 벗어나거나 사라진 뒤
            # 2) 새 도로 중심선이 다시 카메라 중앙 부근으로 들어오면
            # 회전 완료로 판단한다.
            # ------------------------------------------------
            if turn_target == 1:

                if (
                    error is None
                    or abs(error)
                    > int(
                        w
                        * TURN_DEPART_ERROR_RATIO
                    )
                ):

                    turn_departed_old_lane = True


                if (
                    turn_frames
                    >= TURN_MIN_FRAMES

                    and turn_departed_old_lane

                    and error is not None

                    and abs(error)
                    < int(
                        w
                        * TURN_REACQUIRE_ERROR_RATIO
                    )
                ):

                    completed_turns.add(1)

                    first_turn_done = True
                    first_timer_turn_started = True

                    # 1번 교차로는 이미 지나간 것으로 유지
                    intersection_count = max(
                        intersection_count,
                        1
                    )

                    # 같은 교차로를 바로 2번으로 다시 세는 것 방지
                    intersection_locked = True
                    clear_counter = 0

                    print(
                        "RIGHT TURN 1 COMPLETE"
                    )

                    turning = False
                    turn_target = None
                    turn_frames = 0
                    turn_departed_old_lane = False


            # ------------------------------------------------
            # 이후 2, 3번 교차로
            #
            # 맨 처음 성공했던 우회전 종료 조건 그대로:
            # 최소 회전 + 교차로 탈출 + 새 중심선 발견
            # ------------------------------------------------
            else:

                if (
                    turn_frames
                    >= TURN_MIN_FRAMES

                    and not is_intersection

                    and error is not None
                ):

                    completed_turns.add(
                        turn_target
                    )

                    print(
                        f"RIGHT TURN "
                        f"{turn_target} COMPLETE"
                    )

                    turning = False
                    turn_target = None
                    turn_frames = 0
                    turn_departed_old_lane = False


            # ------------------------------------------------
            # 무한 회전 안전장치
            # ------------------------------------------------
            if (
                turning
                and turn_frames
                >= TURN_MAX_FRAMES
            ):

                print(
                    "RIGHT TURN TIMEOUT - STOP"
                )

                stop()

                auto_mode = False
                turning = False
                turn_target = None
                turn_frames = 0
                turn_departed_old_lane = False


        # =================================================
        # B. 첫 번째 교차로:
        # AUTO 시작 후 18.8초 → 강제 우회전
        # =================================================
        elif (
            not first_turn_done
            and not first_timer_turn_started
            and auto_start_time is not None
            and elapsed_time >= FIRST_TURN_TIME
        ):

            # 첫 교차로를 1번으로 지정
            intersection_count = 1

            first_timer_turn_started = True

            turning = True
            turn_target = 1
            turn_frames = 0
            turn_departed_old_lane = False

            print(
                "18.8 sec -> INTERSECTION 1 -> RIGHT TURN"
            )

            drive(
                TURN_SPEED,
                -TURN_SPEED
            )


        # =================================================
        # C. 이후 2번 / 3번 교차로
        #
        # 기존 1차 코드의 white_ratio 교차로 검출 +
        # 우회전 로직 그대로 사용
        # =================================================
        elif (
            first_turn_done

            and is_intersection

            and intersection_count in [2, 3]

            and intersection_count
            not in completed_turns
        ):

            turning = True

            turn_target = (
                intersection_count
            )

            turn_frames = 0
            turn_departed_old_lane = False

            print(
                f"INTERSECTION "
                f"{intersection_count}"
                f" -> RIGHT TURN"
            )

            drive(
                TURN_SPEED,
                -TURN_SPEED
            )


        # =================================================
        # D. 정상 중심선 발견
        # =================================================
        elif error is not None:

            correction = (
                KP * error
            )


            left_speed = (
                BASE_SPEED
                + correction
            )

            right_speed = (
                BASE_SPEED
                - correction
            )


            left_speed = np.clip(
                left_speed,
                0,
                MAX_SPEED
            )

            right_speed = np.clip(
                right_speed,
                0,
                MAX_SPEED
            )


            drive(
                left_speed,
                right_speed
            )


        # =================================================
        # E. 중심선을 잃었을 경우
        # =================================================
        else:

            if last_error < 0:

                drive(
                    0,
                    SEARCH_SPEED
                )


            elif last_error > 0:

                drive(
                    SEARCH_SPEED,
                    0
                )


            else:

                stop()


    # =====================================================
    # 16. 화면 메시지
    # =====================================================
    if turning:

        message = (
            f"TURNING RIGHT {turn_target}"
        )

        cv2.putText(
            result,
            message,
            (20, 75),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.58,
            (0, 0, 255),
            2
        )


    elif (
        first_turn_done
        and is_intersection
    ):

        if intersection_count == 2:

            message = (
                "INTERSECTION 2 - RIGHT"
            )

        elif intersection_count == 3:

            message = (
                "INTERSECTION 3 - RIGHT"
            )

        else:

            message = (
                f"INTERSECTION "
                f"{intersection_count}"
            )


        cv2.putText(
            result,
            message,
            (20, 75),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.58,
            (0, 0, 255),
            2
        )


    # =====================================================
    # 17. 상태 표시
    # =====================================================
    mode_text = (
        "AUTO"
        if auto_mode
        else "MANUAL"
    )


    cv2.putText(
        result,
        f"MODE: {mode_text}",
        (20, 105),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.6,
        (255, 0, 0),
        2
    )


    cv2.putText(
        result,
        f"Intersection: {intersection_count}",
        (20, 135),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.5,
        (255, 0, 0),
        2
    )


    cv2.putText(
        result,
        f"White ratio: {white_ratio:.2f}",
        (20, 165),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.5,
        (255, 0, 0),
        2
    )


    # 첫 턴 전에는 18.8초 카운트 표시
    if not first_turn_done:

        cv2.putText(
            result,
            f"First turn timer: "
            f"{elapsed_time:.1f}/{FIRST_TURN_TIME:.1f}s",
            (20, 195),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.52,
            (255, 0, 0),
            2
        )


    else:

        cv2.putText(
            result,
            "First timed turn: DONE",
            (20, 195),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.52,
            (255, 0, 0),
            2
        )


    # =====================================================
    # 18. 영상 출력
    # =====================================================
    cv2.imshow(
        "Pinky Centerline",
        result
    )

    cv2.imshow(
        "Road Mask",
        tracking_mask
    )


    # =====================================================
    # 19. 키보드
    # =====================================================
    key = cv2.waitKey(1) & 0xFF


    # -----------------------------------------------------
    # AUTO ON / OFF
    # -----------------------------------------------------
    if key == ord("p"):

        auto_mode = not auto_mode

        stop()


        # 최초 AUTO ON 순간에만 18.8초 타이머 시작
        if (
            auto_mode
            and auto_start_time is None
        ):

            auto_start_time = (
                time.monotonic()
            )

            print(
                "AUTO ON - FIRST TURN TIMER START"
            )


        elif auto_mode:

            print(
                "AUTO ON"
            )


        else:

            print(
                "AUTO OFF"
            )


    # -----------------------------------------------------
    # 수동 전진
    # -----------------------------------------------------
    elif key == ord("w"):

        auto_mode = False

        drive(
            30,
            30
        )

        print("FORWARD")


    # -----------------------------------------------------
    # 수동 후진
    # -----------------------------------------------------
    elif key == ord("s"):

        auto_mode = False

        drive(
            -30,
            -30
        )

        print("BACKWARD")


    # -----------------------------------------------------
    # 수동 좌회전
    # -----------------------------------------------------
    elif key == ord("a"):

        auto_mode = False

        drive(
            -25,
            25
        )

        print("LEFT")


    # -----------------------------------------------------
    # 수동 우회전
    # -----------------------------------------------------
    elif key == ord("d"):

        auto_mode = False

        drive(
            25,
            -25
        )

        print("RIGHT")


    # -----------------------------------------------------
    # 긴급 정지
    # -----------------------------------------------------
    elif key == 32:

        auto_mode = False

        stop()

        print("STOP")


    # -----------------------------------------------------
    # 전체 주행 상태 초기화
    # -----------------------------------------------------
    elif key == ord("r"):

        intersection_count = 0
        intersection_locked = False
        clear_counter = 0

        last_error = 0

        turning = False
        turn_target = None
        turn_frames = 0
        turn_departed_old_lane = False

        completed_turns.clear()

        auto_start_time = None
        first_timer_turn_started = False
        first_turn_done = False

        auto_mode = False

        stop()

        print(
            "FULL ROUTE RESET"
        )


    # -----------------------------------------------------
    # 종료
    # -----------------------------------------------------
    elif key == 27:

        stop()
        break


# =========================================================
# 종료
# =========================================================
stop()

cap.release()

cv2.destroyAllWindows()

print("종료")
